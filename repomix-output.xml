<file path="src/services/catalog.service.ts">
import { cache } from "react";
import "server-only";
import { getPayload } from "payload";
import configPromise from "@/payload.config";

export interface CatalogItem {
  id: string;
  title: string;
  slug: string;
  year: number;
  catalog_type: "full_catalog" | "technical" | "collection" | "guide";
  description?: string;
  cover_image: { url: string; alt?: string } | string;
  pdf_file: { url: string; filename?: string } | string;
  file_size_mb: number;
  page_count?: number;
  status: "published" | "draft";
}

export const getGroupedCatalogsService = cache(
  async (
    locale: "fa" | "en" | "ar",
  ): Promise<Record<number, CatalogItem[]>> => {
    try {
      const payload = await getPayload({ config: configPromise });

      const response = await payload.find({
        collection: "catalogs",
        locale,
        limit: 100,
        where: {
          status: { equals: "published" },
        },
        sort: "-year",
        depth: 2,
      });

      const docs = (response.docs as unknown as CatalogItem[]) || [];

      // گروه بندی سالیانه
      return docs.reduce(
        (acc, catalog) => {
          const year = catalog.year || new Date().getFullYear();
          if (!acc[year]) acc[year] = [];
          acc[year].push(catalog);
          return acc;
        },
        {} as Record<number, CatalogItem[]>,
      );
    } catch (error) {
      console.error("Error fetching grouped catalogs:", error);
      return {};
    }
  },
);
</file>

<file path="docker-compose.yml">
services:
  postgres:
    image: postgres:15-alpine
    container_name: persisquartz_db
    restart: unless-stopped
    env_file:
      - .env
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-persisquartz}
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-persisquartz}",
        ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    networks:
      - app_network

  minio:
    image: minio/minio:latest
    container_name: persisquartz_minio
    restart: unless-stopped
    ports:
      - "9000:9000"
      - "9001:9001"
    environment:
      MINIO_ROOT_USER: ${S3_ACCESS_KEY:-persis_admin}
      MINIO_ROOT_PASSWORD: ${S3_SECRET_KEY:-persis_secret_123}
    volumes:
      - minio_data:/data
    command: server /data --console-address ":9001"
    networks:
      - app_network

  minio-setup:
    image: minio/mc:latest
    container_name: persisquartz_minio_setup
    depends_on:
      - minio
    env_file:
      - .env
    entrypoint: >
      /bin/sh -c "
      until (/usr/bin/mc alias set myminio http://minio:9000 $${S3_ACCESS_KEY:-persis_admin} $${S3_SECRET_KEY:-persis_secret_123}); do
        echo 'Waiting for MinIO to initialize...';
        sleep 2;
      done;
      /usr/bin/mc mb myminio/$${S3_BUCKET:-persisquartz} --ignore-existing;
      /usr/bin/mc anonymous set download myminio/$${S3_BUCKET:-persisquartz};
      echo 'MinIO Bucket setup completed successfully!';
      exit 0;
      "
    networks:
      - app_network

volumes:
  pgdata:
    name: persisquartz_pgdata
  minio_data:
    name: persisquartz_miniodata

networks:
  app_network:
    driver: bridge
</file>

