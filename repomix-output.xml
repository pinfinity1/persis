  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --radius-sm: calc(var(--radius) * 0.6);
  --radius-md: calc(var(--radius) * 0.8);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) * 1.4);
  --radius-2xl: calc(var(--radius) * 1.8);
  --radius-3xl: calc(var(--radius) * 2.2);
  --radius-4xl: calc(var(--radius) * 2.6);
}

:root {
  --background: oklch(0.99 0 0);
  --foreground: oklch(0.15 0.01 15);

  /* Brand Color: #9B0737 (Burgundy / Crimson) */
  --primary: oklch(0.38 0.18 15);
  --primary-foreground: oklch(0.99 0 0);

  /* Secondary & Accents */
  --secondary: oklch(0.96 0.01 15);
  --secondary-foreground: oklch(0.25 0.12 15);
  --muted: oklch(0.96 0.005 15);
  --muted-foreground: oklch(0.5 0.02 15);
  --accent: oklch(0.94 0.02 15);
  --accent-foreground: oklch(0.38 0.18 15);

  --card: oklch(1 0 0);
  --card-foreground: oklch(0.15 0.01 15);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.15 0.01 15);
  --border: oklch(0.91 0.01 15);
  --input: oklch(0.91 0.01 15);
  --ring: oklch(0.38 0.18 15);
  --radius: 0.5rem;
}

.dark {
  --background: oklch(0.12 0.01 15);
  --foreground: oklch(0.98 0 0);

  --primary: oklch(0.48 0.2 15);
  --primary-foreground: oklch(0.99 0 0);

  --secondary: oklch(0.2 0.03 15);
  --secondary-foreground: oklch(0.98 0 0);
  --muted: oklch(0.2 0.02 15);
  --muted-foreground: oklch(0.65 0.01 15);
  --accent: oklch(0.25 0.04 15);
  --accent-foreground: oklch(0.98 0 0);

  --card: oklch(0.16 0.01 15);
  --card-foreground: oklch(0.98 0 0);
  --popover: oklch(0.16 0.01 15);
  --popover-foreground: oklch(0.98 0 0);
  --border: oklch(0.25 0.02 15);
  --input: oklch(0.25 0.02 15);
  --ring: oklch(0.48 0.2 15);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
  }
}

@keyframes marquee-left {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

@keyframes marquee-right {
  0% {
    transform: translateX(-50%);
  }
  100% {
    transform: translateX(0);
  }
}

.animate-marquee-left {
  animation: marquee-left 40s linear infinite;
}

.animate-marquee-right {
  animation: marquee-right 40s linear infinite;
}
</file>

