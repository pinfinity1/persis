"use client";

import React, { useState } from "react";
import { Link } from "@/i18n/routing";
import { useTranslations } from "next-intl";
import { Button } from "@/components/ui/button";
import {
  Box,
  MapPin,
  FileText,
  Share2,
  Check,
  CheckCircle2,
  ShieldCheck,
  Clock,
  Sparkles,
} from "lucide-react";
import type { ProductItem } from "@/services/product.service";

interface ProductConfiguratorProps {
  product: ProductItem;
  categoryTitle: string;
}

export const ProductConfigurator: React.FC<ProductConfiguratorProps> = ({
  product,
  categoryTitle,
}) => {
  const t = useTranslations("ProductDetail");

  const thicknesses = product.available_thicknesses?.length
    ? product.available_thicknesses
    : ["12mm", "20mm", "30mm"];

  const finishes = product.finishes?.length
    ? product.finishes
    : ["polished", "honed"];

  const [selectedThickness, setSelectedThickness] = useState(thicknesses[0]);
  const [selectedFinish, setSelectedFinish] = useState(finishes[0]);
  const [copied, setCopied] = useState(false);

  const sampleUrl = `/contact?type=sample&code=${encodeURIComponent(
    product.code,
  )}&thickness=${encodeURIComponent(
    selectedThickness,
  )}&finish=${encodeURIComponent(selectedFinish)}`;

  const handleShare = async () => {
    if (typeof window !== "undefined") {
      await navigator.clipboard.writeText(window.location.href);
      setCopied(true);
      setTimeout(() => setCopied(false), 2500);
    }
  };

  const isStockAvailable = product.is_in_stock === "in_stock";

  return (
    <div className="space-y-8">
      {/* ۱. هدر شناسه و وضعیت موجودی */}
      <div className="space-y-3">
        <div className="flex items-center justify-between gap-3 flex-wrap">
          <div className="flex items-center gap-2">
            <span className="text-xs font-mono font-bold tracking-widest text-primary uppercase border border-primary/40 bg-primary/5 px-2.5 py-1">
              CODE: {product.code}
            </span>
            {categoryTitle && (
              <span className="text-xs font-mono text-muted-foreground uppercase border border-border/50 px-2 py-1">
                {categoryTitle}
              </span>
            )}
          </div>

          <button
            onClick={handleShare}
            className="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors"
          >
            {copied ? (
              <>
                <Check className="h-3.5 w-3.5 text-primary" />
                <span className="text-primary font-medium">{t("copied")}</span>
              </>
            ) : (
              <>
                <Share2 className="h-3.5 w-3.5" />
                <span>{t("share")}</span>
              </>
            )}
          </button>
        </div>

        <h1 className="text-3xl sm:text-4xl lg:text-5xl font-light text-foreground tracking-tight">
          {product.title}
        </h1>

        <div className="flex items-center gap-2 pt-1 text-xs">
          {isStockAvailable ? (
            <span className="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-medium">
              <span className="h-2 w-2 rounded-full bg-emerald-500 animate-pulse" />
              {t("inStock")}
            </span>
          ) : (
            <span className="flex items-center gap-1.5 text-amber-600 dark:text-amber-400 font-medium">
              <Clock className="h-3.5 w-3.5" />
              {t("onDemand")}
            </span>
          )}
        </div>
      </div>

      {/* ۲. توضیحات کانسپت و متریال */}
      {product.description && (
        <p className="text-sm font-light text-muted-foreground leading-relaxed">
          {product.description}
        </p>
      )}

      {/* ۳. انتخابگر تعاملی متغیرها (ضخامت و فینیش) */}
      <div className="space-y-6 border-y border-border/50 py-6 bg-card/40 p-4">
        {/* انتخاب ضخامت */}
        <div className="space-y-2.5">
          <div className="flex items-center justify-between">
            <label className="text-xs uppercase font-mono tracking-wider text-foreground font-semibold">
              {t("thickness")}
            </label>
            <span className="text-xs font-mono text-primary font-bold">
              {selectedThickness}
            </span>
          </div>

          <div className="grid grid-cols-3 sm:grid-cols-4 gap-2">
            {thicknesses.map((th) => (
              <button
                key={th}
                onClick={() => setSelectedThickness(th)}
                className={`py-2.5 px-3 text-xs font-mono border transition-all text-center ${
                  selectedThickness === th
                    ? "border-primary bg-primary text-primary-foreground font-bold shadow-sm"
                    : "border-border/60 bg-card hover:border-border text-foreground"
                }`}
              >
                {th}
              </button>
            ))}
          </div>
        </div>

        {/* انتخاب نوع پرداخت و فینیش */}
        <div className="space-y-2.5">
          <div className="flex items-center justify-between">
            <label className="text-xs uppercase font-mono tracking-wider text-foreground font-semibold">
              {t("finish")}
            </label>
            <span className="text-xs font-mono text-primary font-bold uppercase">
              {selectedFinish}
            </span>
          </div>

          <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
            {finishes.map((fn) => (
              <button
                key={fn}
                onClick={() => setSelectedFinish(fn)}
                className={`py-2.5 px-3 text-xs font-mono uppercase border transition-all text-center flex items-center justify-center gap-2 ${
                  selectedFinish === fn
                    ? "border-primary bg-primary text-primary-foreground font-bold shadow-sm"
                    : "border-border/60 bg-card hover:border-border text-foreground"
                }`}
              >
                <span>{fn}</span>
                {selectedFinish === fn && <Check className="h-3 w-3" />}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* ۴. اکشن‌های تبدیل B2B (Conversion CTA) */}
      <div className="space-y-3 pt-2">
        <Button
          asChild
          size="lg"
          className="w-full h-14 bg-primary text-primary-foreground hover:bg-primary/90 rounded-none text-xs sm:text-sm tracking-wider uppercase font-semibold shadow-md transition-transform active:scale-[0.99]"
        >
          <Link
            href={sampleUrl}
            className="flex items-center justify-center gap-3"
          >
            <Box className="h-5 w-5" />
            <div className="text-start">
              <span>{t("requestSample")}</span>
              <span className="block text-[10px] font-normal opacity-80 font-sans">
                {t("requestSampleDesc")}
              </span>
            </div>
          </Link>
        </Button>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <Button
            asChild
            variant="outline"
            className="w-full h-12 border-border/80 hover:bg-muted text-foreground rounded-none text-xs tracking-wider uppercase font-medium"
          >
            <Link
              href="/dealers"
              className="flex items-center justify-center gap-2"
            >
              <MapPin className="h-4 w-4 text-primary" />
              <span>{t("findDealer")}</span>
            </Link>
          </Button>

          <Button
            asChild
            variant="outline"
            className="w-full h-12 border-border/80 hover:bg-muted text-foreground rounded-none text-xs tracking-wider uppercase font-medium"
          >
            <a
              href={product.specsSheetUrl || "/catalogs"}
              target="_blank"
              rel="noopener noreferrer"
              className="flex items-center justify-center gap-2"
            >
              <FileText className="h-4 w-4 text-muted-foreground" />
              <span>{t("downloadTds")}</span>
            </a>
          </Button>
        </div>
      </div>

      {/* ۵. نشان اصالت و کیفیت مهندسی */}
      <div className="p-4 bg-muted/20 border border-border/40 flex items-center gap-3 text-xs text-muted-foreground">
        <ShieldCheck className="h-5 w-5 text-primary shrink-0" />
        <span>
          تضمین کیفیت ساختاری با متریال برتون (Bretonstone Technology) و ۱۰ سال
          ضمانت محدود.
        </span>
      </div>
    </div>
  );
};
</file>

<file path="src/components/products/product-specs-matrix.tsx">
import React from "react";
import { getTranslations } from "next-intl/server";
import {
  ShieldAlert,
  Flame,
  Droplets,
  Sparkles,
  Layers,
  Activity,
  CheckCircle2,
  Utensils,
  Bath,
  Building2,
} from "lucide-react";

interface ProductSpecsMatrixProps {
  locale: string;
}

export async function ProductSpecsMatrix({ locale }: ProductSpecsMatrixProps) {
  const t = await getTranslations({ locale, namespace: "ProductDetail" });

  const specs = [
    {
      label: t("specDimension"),
      value: "320 × 75 cm / 320 × 92 cm / 320 × 160 cm",
    },
    { label: t("specComposition"), value: t("specCompositionVal") },
    { label: t("specHardness"), value: t("specHardnessVal") },
    { label: t("specAbsorption"), value: t("specAbsorptionVal") },
    { label: t("specMaintenance"), value: t("specMaintenanceVal") },
  ];

  const applications = [
    {
      title: t("appKitchen"),
      desc: t("appKitchenDesc"),
      icon: Utensils,
    },
    {
      title: t("appVanity"),
      desc: t("appVanityDesc"),
      icon: Bath,
    },
    {
      title: t("appCommercial"),
      desc: t("appCommercialDesc"),
      icon: Building2,
    },
  ];

  return (
    <div className="space-y-16 pt-12 border-t border-border/40">
      {/* جدول مشخصات فنی استاندارد */}
      <div className="space-y-6">
        <div className="flex items-center gap-3">
          <span className="h-px w-8 bg-primary" />
          <h2 className="text-xl sm:text-2xl font-light text-foreground uppercase tracking-tight">
            {t("specsTitle")}
          </h2>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {specs.map((item, idx) => (
            <div
              key={idx}
              className="p-4 bg-card border border-border/50 flex flex-col justify-between space-y-1.5 hover:border-primary/40 transition-colors"
            >
              <span className="text-[11px] font-mono uppercase tracking-widest text-primary">
                {item.label}
              </span>
              <span className="text-sm font-light text-foreground">
                {item.value}
              </span>
            </div>
          ))}
        </div>
      </div>

      {/* کاربری‌های معمارانه (Architectural Applications) */}
      <div className="space-y-6">
        <div className="flex items-center gap-3">
          <span className="h-px w-8 bg-primary" />
          <h2 className="text-xl sm:text-2xl font-light text-foreground uppercase tracking-tight">
            {t("applicationsTitle")}
          </h2>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          {applications.map((app, idx) => {
            const Icon = app.icon;
            return (
              <div
                key={idx}
                className="p-6 bg-card border border-border/50 space-y-4 hover:border-primary/60 transition-all duration-300 group"
              >
                <div className="p-3 bg-muted/40 w-fit border border-border/40 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-colors">
                  <Icon className="h-5 w-5" />
                </div>
                <div className="space-y-1.5">
                  <h3 className="text-base font-medium text-foreground">
                    {app.title}
                  </h3>
                  <p className="text-xs text-muted-foreground font-light leading-relaxed">
                    {app.desc}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}
